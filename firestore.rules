rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Regla estricta para perfiles de usuario
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Regla de Seguridad Multi-Tenant Aislada por Ruta (/tenants/{tenantId}/{collectionId}/{document})
    // Exige sesión autenticada para leer o escribir en la base de datos de cualquier empresa
    match /tenants/{tenantId}/{collectionId}/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Reglas de compatibilidad legacy para colecciones raíz
    match /plants/{document} {
      allow read, write: if isAuthenticated();
    }

    match /materials/{document} {
      allow read, write: if isAuthenticated();
    }

    match /assets/{document} {
      allow read, write: if isAuthenticated();
    }

    match /notifications/{document} {
      allow read, write: if isAuthenticated();
    }

    match /workOrders/{document} {
      allow read, write: if isAuthenticated();
    }

    match /purchaseOrders/{document} {
      allow read, write: if isAuthenticated();
    }

    match /migoDocuments/{document} {
      allow read, write: if isAuthenticated();
    }

    // Regla de salvaguarda global
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
